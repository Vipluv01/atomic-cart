MONGODB_URI=mongodb://127.0.0.1:27017/nextshop

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=nextshop-product-images
# Optional: point at an S3-compatible server (e.g. MinIO) for local dev
# instead of real AWS. Leave unset in production.
# S3_ENDPOINT=http://127.0.0.1:9000

AUTH_SECRET=replace-with-a-real-random-secret
# Required when self-hosting or running on a non-default port/host — Vercel
# sets this automatically, but Auth.js v5 rejects every request with
# UntrustedHost without it otherwise.
AUTH_TRUST_HOST=true

NEXT_PUBLIC_BASE_URL=http://localhost:3000
